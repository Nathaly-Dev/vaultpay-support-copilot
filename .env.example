# Copie para .env e preencha. Nunca commite o .env.
POSTGRES_USER=vaultpay
POSTGRES_PASSWORD=
POSTGRES_DB=vaultpay_copilot
POSTGRES_PORT=5432

# Modelo local (Ollama). Não há chave: tudo roda neste computador.
OLLAMA_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3:4b-instruct
LLM_TIMEOUT_S=120
# Abaixo desta similaridade o atendente encaminha sem chamar o modelo (provisório).
MIN_SIMILARITY=0.80
# Mantém o modelo na memória por este tempo depois de usar ("30m", "2h", -1 = sempre;
# vazio = padrão do Ollama, 5 min). Custo: ~3 GB de RAM ocupados enquanto isso.
LLM_KEEP_ALIVE=30m
# Teto de tokens por resposta (vazio = sem teto). Medido: não acelera; deixe vazio.
LLM_NUM_PREDICT=
