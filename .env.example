# Copie para .env e preencha. Nunca commite o .env.
POSTGRES_USER=vaultpay
POSTGRES_PASSWORD=
POSTGRES_DB=vaultpay_copilot
POSTGRES_PORT=5432

# Modelo local (Ollama). Não há chave: tudo roda neste computador.
OLLAMA_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3:4b-instruct
LLM_TIMEOUT_S=120
# Abaixo desta similaridade o atendente encaminha sem chamar o modelo (provisório).
MIN_SIMILARITY=0.80
